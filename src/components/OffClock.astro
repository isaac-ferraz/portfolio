---
import { Picture, getImage } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Icon from './Icon.astro';
import Lightbox from './Lightbox.astro';
import { stages } from '~/data/offclock';
import { homePath, pick, useTranslations, type Lang } from '~/i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = homePath(lang);

let level = 0;
const items = await Promise.all(
  stages.map(async (s, i) => ({
    ...s,
    i,
    label: s.bonus ? t('off.bonus') : `${t('off.stage')} 1-${++level}`,
    full: s.photo ? (await getImage({ src: s.photo.src, width: Math.min(s.photo.src.width, 1800), format: 'webp' })).src : '',
  })),
);
---

<Base lang={lang} title={t('off.meta.title')} description={t('off.meta.description')} og={`og/${lang}/fora-do-expediente.png`} ogAlt={`${t('off.title')} ${t('off.accent')}`}>
  <div class="off">
    <header class="off-head">
      <div class="wrap head-inner">
        <a class="back" href={home}><Icon name="arrowLeft" />{t('off.back')}</a>
        <div class="hud mono" aria-hidden="true">
          <span>{t('off.hud.player')}</span>
          <span class="hud-stage">{t('off.hud.stage')}</span>
          <span>{t('off.hud.credits')}</span>
        </div>
        <p class="eyebrow mono"><span class="dot" aria-hidden="true"></span>{t('off.eyebrow')}</p>
        <h1>{t('off.title')} <em>{t('off.accent')}</em></h1>
        <p class="lead">{t('off.lead')}</p>
      </div>
    </header>

    <section class="wrap" aria-labelledby="stages-title">
      <h2 id="stages-title" class="sr-only">{t('off.stages')}</h2>
      <ol class="stages" role="list">
        {items.map((s) => (
          <li class="stage" data-stage={s.id} data-bonus={s.bonus ? '' : undefined} style={`--sc: ${s.color}; --i: ${s.i}`}>
            <article aria-labelledby={`st-${s.id}`}>
              <span class="stage-n mono" aria-hidden="true">{s.label}</span>
              {s.photo ? (
                <button class="shot" type="button" data-enlarge data-full={s.full} data-alt={pick(s.photo.alt, lang)} data-caption={pick(s.title, lang)}>
                  <Picture src={s.photo.src} alt={pick(s.photo.alt, lang)} formats={['avif', 'webp']}
                    widths={[480, 720, 960, 1280].filter((w) => w <= s.photo!.src.width)}
                    sizes={s.id === 'igreja' ? '(min-width: 64rem) 48rem, 94vw' : '(min-width: 64rem) 36rem, (min-width: 40rem) 46vw, 94vw'}
                    loading={s.i === 0 ? 'eager' : 'lazy'} decoding="async"
                    style={s.photo.focus ? `object-position: ${s.photo.focus}` : undefined} />
                  <span class="sr-only">{t('detail.enlarge')}</span>
                </button>
              ) : (
                <div class="bonus-art" aria-hidden="true">
                  <svg viewBox="0 0 120 80" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <!-- martelo -->
                    <path d="M22 72 L33 26" stroke-width="7" />
                    <path d="M22 72 L33 26" stroke="#e0b07a" stroke-width="3.2" />
                    <path d="M17.5 21.5 L21 12 L47 18 Q50 22 46 28 L20 24 Z" fill="#9aa3ad" />
                    <!-- serrote -->
                    <path d="M46.0 62.0 L92.0 34.0 L100.0 52.0 L100.0 52.0 L98.9 56.1 L95.5 53.7 L94.4 57.8 L90.9 55.5 L89.8 59.5 L86.4 57.2 L85.3 61.2 L81.8 58.9 L80.7 63.0 L77.3 60.6 L76.2 64.7 L72.7 62.4 L71.7 66.4 L68.2 64.1 L67.1 68.2 L63.6 65.8 L62.6 69.9 L59.1 67.5 L58.0 71.6 L54.5 69.3 L53.5 73.3 L50.0 71.0 Z" fill="#eceae4" />
                    <path d="M90 31 L108 23 Q117 22 117 32 L114 46 Q112 53 104 53 L98 53 Z" fill="#c0392b" />
                    <path d="M103 35 L109 32 Q111 32 111 35 L109.5 42 Q109 44 107 44 L105 44 Z" fill="#d9a066" />
                    <circle cx="60" cy="56" r="1.4" fill="currentColor" stroke="none" />
                  </svg>
                </div>
              )}
              <div class="stage-body">
                <span class="chip">{pick(s.tag, lang)}</span>
                <h3 id={`st-${s.id}`}>{pick(s.title, lang)}</h3>
                <p>{pick(s.text, lang)}</p>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap continue" aria-labelledby="continue-title">
      <div class="continue-box halftone">
        <span class="count" aria-hidden="true">9</span>
        <h2 id="continue-title">{t('off.continue')}</h2>
        <p>{t('off.continue.text')}</p>
        <div class="ctas">
          <a class="btn btn-primary" href={home}>{t('off.back')}<Icon name="arrowRight" /></a>
          <a class="btn" href={`${home}#contact`}>{t('off.contact')}</a>
        </div>
      </div>
    </section>
  </div>
  <Lightbox lang={lang} slot="after" />
</Base>

<style>
  .off { padding-bottom: clamp(4rem, 3rem + 4vw, 7rem); }

  /* ----- topo: tela de arcade (pontos + scanlines decorativas) ----- */
  .off-head {
    position: relative; padding: calc(var(--header-h) + 2rem) 0 clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    background-image:
      repeating-linear-gradient(transparent 0 3px, color-mix(in oklab, var(--ink) 5%, transparent) 3px 4px),
      radial-gradient(var(--dot) 1.2px, transparent 1.6px);
    background-size: auto, 14px 14px;
  }
  .head-inner { display: grid; gap: 1.1rem; justify-items: start; }
  .back { display: inline-flex; gap: 0.4rem; align-items: center; font-weight: 650; font-size: var(--step--1); text-decoration: none; }
  .back :global(svg) { width: 1rem; height: 1rem; }

  .hud {
    justify-self: stretch; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    padding: 0.55rem 1rem; border: var(--border); border-radius: 10px;
    background: #16151a; color: #ffd23f; box-shadow: 4px 4px 0 var(--line-strong);
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
  }
  .hud-stage { color: #f3efe6; }

  .eyebrow {
    display: inline-flex; align-items: center; gap: 0.55rem; margin-top: 0.8rem;
    font-size: var(--step--1); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--pop);
  }
  .dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: currentColor; }
  h1 { font-size: var(--step-5); letter-spacing: -0.04em; line-height: 0.92; text-transform: uppercase; }
  h1 em { color: var(--accent-ink); text-transform: none; }
  .lead { font-size: var(--step-2); line-height: 1.25; max-width: 40rem; color: var(--ink-soft); }

  /* ----- seleção de fases ----- */
  .stages {
    display: grid; gap: clamp(1.4rem, 1rem + 1.5vw, 2.2rem);
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  .stage[data-stage='igreja'] { grid-column: span 4; }
  .stage[data-bonus] { grid-column: span 2; }
  .stage[data-stage='ic-college'], .stage[data-stage='corinthians'] { grid-column: span 3; }

  .stage article {
    position: relative; height: 100%; display: flex; flex-direction: column;
    background: var(--surface); border: var(--border); border-radius: var(--radius-lg);
    box-shadow: 8px 8px 0 var(--sc); overflow: clip;
  }
  .stage-n {
    position: absolute; top: 0.8rem; left: 0.8rem; z-index: 2; padding: 0.15rem 0.55rem;
    background: var(--accent); color: var(--on-accent); border: var(--border); border-radius: 8px;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .shot {
    display: block; width: 100%; aspect-ratio: 4 / 3; overflow: clip; cursor: zoom-in;
    border-bottom: var(--border); background: var(--surface-2);
  }
  .stage[data-stage='igreja'] .shot { aspect-ratio: 16 / 9; }
  .shot :global(picture) { display: block; width: 100%; height: 100%; }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; transition: scale 0.5s var(--ease-out); }
  .shot:hover :global(img) { scale: 1.04; }
  .shot:focus-visible { outline-offset: -6px; }

  .stage-body { display: grid; gap: 0.6rem; justify-items: start; padding: 1.3rem 1.4rem 1.5rem; }
  .stage-body h3 { font-size: var(--step-2); }
  .stage-body p { color: var(--ink-soft); }

  /* Curiosidade: madeira no lugar da foto. */
  .bonus-art {
    display: grid; place-items: center; aspect-ratio: 4 / 3; border-bottom: var(--border); color: #16151a;
    background:
      repeating-linear-gradient(100deg, transparent 0 22px, rgb(90 50 15 / 0.16) 22px 24px, transparent 24px 41px, rgb(90 50 15 / 0.1) 41px 42px),
      linear-gradient(#e3b07a, #c98b4e);
  }
  .bonus-art svg { width: 62%; height: auto; }
  .stage[data-bonus] .stage-n { background: #16151a; color: #ffd23f; }

  /* ----- continue? ----- */
  .continue { margin-top: clamp(4rem, 3rem + 4vw, 7rem); }
  .continue-box {
    position: relative; display: grid; gap: 1rem; justify-items: center; text-align: center;
    padding: clamp(2rem, 1.5rem + 3vw, 3.5rem) var(--gutter);
    border: var(--border); border-radius: var(--radius-lg); background-color: var(--surface); box-shadow: var(--shadow-comic);
  }
  .continue-box h2 {
    font-family: var(--font-comic); font-weight: 400; font-size: var(--step-5); letter-spacing: 0.04em;
    line-height: 0.9; color: var(--accent-ink);
  }
  .continue-box p { max-width: 34rem; color: var(--ink-soft); font-size: var(--step-1); }
  .count {
    display: grid; place-items: center; width: 3.6rem; height: 3.6rem; border-radius: 50%;
    border: var(--border); background: #16151a; color: #ffd23f;
    font-family: var(--font-comic); font-size: 2rem; line-height: 1;
  }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; margin-top: 0.6rem; }

  /* Entrada: só transform, o conteúdo já está pintado. */
  @media (prefers-reduced-motion: no-preference) {
    .stage { animation: stage-in 0.7s var(--ease-out) both; animation-delay: calc(0.1s + var(--i) * 0.09s); }
    .dot { animation: blink 1.1s steps(1) 4; }
  }
  @keyframes stage-in { from { transform: translateY(28px) scale(0.97); } }
  @keyframes blink { 50% { opacity: 0; } }

  @media (max-width: 63.99rem) {
    .stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stage[data-stage='igreja'], .stage[data-bonus] { grid-column: span 2; }
    .stage[data-stage='ic-college'], .stage[data-stage='corinthians'] { grid-column: span 1; }
    .stage[data-bonus] article { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
    .stage[data-bonus] .bonus-art { aspect-ratio: auto; height: 100%; border-bottom: 0; border-right: var(--border); }
  }
  @media (max-width: 40rem) {
    .stages { grid-template-columns: minmax(0, 1fr); }
    .stage[data-stage] { grid-column: auto; }
    .stage[data-bonus] article { display: flex; }
    .stage[data-bonus] .bonus-art { aspect-ratio: 16 / 9; height: auto; border-right: 0; border-bottom: var(--border); }
    .hud { justify-content: center; }
    .hud-stage { order: 3; flex-basis: 100%; text-align: center; }
  }
</style>
