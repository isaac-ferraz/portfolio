---
import { offClockPath, useTranslations, type Lang } from '~/i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Botão de fliperama: leva à página "Fora do expediente". O painel é escuro nos
     dois temas (como um gabinete de arcade); o botão afunda ao ser pressionado. -->
<a class="arcade" href={offClockPath(lang)}>
  <span class="housing" aria-hidden="true"><span class="cap"></span></span>
  <span class="copy">
    <span class="kicker mono" aria-hidden="true">{t('hero.arcade.kicker')}</span>
    <span class="label">{t('hero.arcade.label')}<span class="sr-only"> — {t('hero.arcade.sr')}</span></span>
  </span>
</a>

<style>
  .arcade {
    --panel: #16151a; --panel-ink: #f3efe6;
    display: inline-flex; align-items: center; gap: 0.85rem;
    padding: 0.45rem 1.4rem 0.45rem 0.45rem; margin-bottom: 1.5rem;
    border: var(--border); border-radius: 999px; text-decoration: none;
    background:
      radial-gradient(rgb(243 239 230 / 0.09) 1px, transparent 1.4px) 0 0 / 8px 8px,
      var(--panel);
    color: var(--panel-ink); box-shadow: 4px 4px 0 var(--accent);
    transition: translate 0.18s var(--ease-out), box-shadow 0.18s var(--ease-out);
  }
  .arcade:hover { translate: -2px -2px; box-shadow: 6px 6px 0 var(--accent); }

  /* Aro amarelo + capa vermelha com profundidade. */
  .housing {
    display: grid; place-items: center; flex: none; width: 3.4rem; height: 3.4rem; border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, #ffe27a, var(--accent) 60%, #d9a400);
    border: 2.5px solid #000; box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.25);
  }
  .cap {
    width: 2.3rem; height: 2.3rem; border-radius: 50%; border: 2px solid #000;
    background: radial-gradient(circle at 36% 30%, #ff9aa8 0 12%, #f0244a 45%, #a3102c 100%);
    box-shadow: 0 5px 0 #6e0a1d, 0 5px 0 2px #000;
    translate: 0 -4px;
    transition: translate 0.12s var(--ease-out), box-shadow 0.12s var(--ease-out);
  }
  .arcade:hover .cap { translate: 0 -5px; box-shadow: 0 6px 0 #6e0a1d, 0 6px 0 2px #000; }
  .arcade:active .cap { translate: 0 0; box-shadow: 0 1px 0 #6e0a1d, 0 1px 0 2px #000; }
  .arcade:active { translate: 0 0; box-shadow: 2px 2px 0 var(--accent); }

  .copy { display: grid; gap: 0.15rem; line-height: 1.05; }
  .kicker { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #ffd23f; }
  .label { font-family: var(--font-comic); font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.55rem); letter-spacing: 0.05em; text-transform: uppercase; }

  /* "Press start" pisca algumas vezes (menos de 5 s) e volta a piscar no hover. */
  @media (prefers-reduced-motion: no-preference) {
    .kicker { animation: blink 1.1s steps(1) 4; animation-delay: 1.4s; }
    .arcade:hover .kicker { animation: blink 0.8s steps(1) 3; }
  }
  @keyframes blink { 50% { opacity: 0; } }
</style>
